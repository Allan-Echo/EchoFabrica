{% extends 'base.html' %}

{% block card %}
  <main class="container my-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0">
          <i class="bi bi-bug-fill me-2"></i>
          Detalhes do Erro (Modo Debug)
        </h5>
      </div>
      <div class="card-body">
        <p><strong>Mensagem:</strong> <span class="text-danger">{{ mensagem }}</span></p>
        <p><strong>Arquivo:</strong> <span class="text-muted">{{ arquivo }}</span></p>
        <p><strong>Linha:</strong> <span class="text-primary">{{ linha }}</span></p>
        <hr>

        <!-- Legenda de cores -->
        <div class="mb-3">
          <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i> Exception</span>
          <span class="badge" style="background-color:#6ea8fe; color:#fff;"><i class="bi bi-code-slash me-1"></i> Twig</span>
          <span class="badge bg-success"><i class="bi bi-diagram-3-fill me-1"></i> Router</span>
          <span class="badge bg-secondary"><i class="bi bi-file-earmark-text me-1"></i> Outros</span>
        </div>

        <h6 class="text-secondary mt-4">Stack Trace:</h6>
        <div class="bg-dark text-light rounded p-3 overflow-auto" style="max-height: 400px;">
          <code class="small font-monospace d-block">
{% for linha in trace|split('\n') %}
  {% if 'Exception' in linha %}
    <div><span class="text-danger fw-bold">{{ linha }}</span></div>
  {% elseif 'Twig' in linha %}
    <div><span style="color:#6ea8fe;">{{ linha }}</span></div>
  {% elseif 'Router' in linha %}
    <div><span class="text-success">{{ linha }}</span></div>
  {% else %}
    <div><span class="text-light">{{ linha }}</span></div>
  {% endif %}
{% endfor %}
          </code>
        </div>

        <div class="text-end mt-3">
          <a href="{{ url('dashboard') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i>
            Voltar ao painel
          </a>
        </div>
      </div>
    </div>
  </main>
{% endblock %}
