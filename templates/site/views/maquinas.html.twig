{% extends 'base.html' %}
{% block card %}
{{flash()}}
  <!-- Link dos ícones do Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <main class="card border-0 shadow-sm container my-3 flex-grow-1">
      <div class="card-header bg-white border-0">
        <h5 class="card-title">
          Máquinas Cadastradas
        </h5>
      </div>
      <div class="card-body">
        {% block main %}
          <!-- Formulário que envolve a tabela para capturar os checkboxes selecionados -->
          <form id="formAcoesEmMassa" method="post">
            <div class="table-responsive">
              <table class="table align-middle">
                <thead>
                  <tr>
                    <!-- Coluna de Checkbox (Oculta por padrão) -->
                    <th scope="col" class="col-selecionar d-none" style="width: 45px;">
                      <input class="form-check-input fs-5" type="checkbox" id="selectAll"></th>
                      <th scope="col">
                        Máquina
                      </th>
                      <th scope="col">
                        Marca
                      </th>
                      <th scope="col">
                        Função
                      </th>
                      <!-- Ícones Redondos e Perfeitos no Cabeçalho -->
                      <th scope="col" class="text-end" style="width: 120px;">
                        <button type="button" class="btn btn-outline-primary rounded-circle d-inline-flex align-items-center justify-content-center me-2" id="btnAtivarDetalhes" title="Selecionar para ver detalhes" style="width: 40px; height: 40px;">
                          <i class="bi bi-eye fs-5"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger rounded-circle d-inline-flex align-items-center justify-content-center" id="btnAtivarExclusao" title="Selecionar para excluir" style="width: 40px; height: 40px;">
                          <i class="bi bi-trash fs-5"></i>
                        </button>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for maquina in maquinas %}
                      <tr>
                        <!-- Checkbox da Linha (Oculto por padrão) -->
                        <td class="col-selecionar d-none">
                          <input class="form-check-input check-maquina" type="checkbox" name="maquinas_selecionadas" value="{{ maquina.id_machine }}"></td>
                          <th class="fs-5 text-uppercase fw-bold" scope="row">
                            {{ maquina.model }}
                          </th>
                          <td>
                            {{ maquina.brand }}
                          </td>
                          <td>
                            {{ maquina.designation }}
                          </td>
                          <td></td>
                        <!-- Espaço vazio para alinhar com os botões do topo -->
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                  <!-- Zona de Ações Inferior (UX unificada ao lado de Cadastrar) -->
                  <!-- Botão link para Cadastro de Máquina -->
                    <a href="{{ url('maquinas/cadastro') }}" class="btn btn-info btn-sm text-white"> <i class="bi bi-plus-lg me-1"></i>
                    Cadastrar Máquina
                  </a>
                  <!-- Botão Dinâmico de Detalhes -->
                  <button type="button" id="btnAcaoDetalhes" class="btn btn-primary btn-sm d-none" data-bs-toggle="modal" data-bs-target="#modalVerDetalhes">
                    <i class="bi bi-card-text me-1"></i>
                    Ver Detalhes Selecionados
                  </button>
                  <!-- Botão Dinâmico de Exclusão -->
                  <button type="button" id="btnAcaoExcluir" class="btn btn-danger btn-sm d-none" data-bs-toggle="modal" data-bs-target="#modalConfirmarExclusao">
                    <i class="bi bi-trash-fill me-1"></i>
                    Excluir Selecionados
                  </button>
                </div>
              </div>
              <!-- MODAL: Confirmação de Exclusão -->
              <div class="modal fade" id="modalConfirmarExclusao" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                      <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Confirmar Exclusão
                      </h5>
                      <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                      <p>
                        Você tem certeza que deseja excluir as máquinas selecionadas? Esta ação não poderá ser desfeita.
                      </p>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                      </button>
                      <button type="submit" class="btn btn-danger">
                        Sim, desejo excluir
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </form>
            <!-- MODAL: Detalhes das Máquinas Selecionadas -->
            <div class="modal fade" id="modalVerDetalhes" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                  <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                      <i class="bi bi-info-circle-fill me-2"></i>
                      Detalhes das Máquinas
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body pb-0">
                    <!-- O Twig já deixa todos os detalhes renderizados e escondidos aqui dentro -->
                    <div id="container-detalhes-lote">
                      {% for maquina in maquinas %}
                        <div class="detalhe-maquina-item d-none mb-4 pb-3 border-bottom" data-id-maquina="{{ maquina.id_machine }}">
                          <h5 class="text-primary text-uppercase fw-bold">
                            {{ maquina.model }}
                          </h5>
                          <div class="row mt-2">
                            <div class="col-6">
                              <strong>
                                Peça por Produção:
                              </strong>
                              {{ maquina.piece_operations }}
                            </div>
                            <div class="col-6">
                              <strong>
                                Valor de Compra:
                              </strong>
                              {{ maquina.purchase_price }}
                            </div>
                          </div>
                          <!-- Adicione aqui quaisquer outros dados que venham na sua variável 'maquina' -->
                          <div class="row mt-2">
                            <div class="col-12">
                              <strong>
                                Quantidade de Máquinas na Fábrica:
                              </strong>
                              {{ maquina.quantity }}
                            </div>
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                  <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                      Fechar
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {% endblock %}
        </main>
      {% endblock %}
      {% block script %}
        <script>
          {% include 'assets/js/maquinas.js' %}                  
        </script> 
      {% endblock %}
      